-- Esconde apenas a cabeça e acessórios para não vazar para fora do NPC
local function setHeadInvisible(char, invisible)
   pcall(function()
       local head = char:FindFirstChild("Head")
       if head then
           head.Transparency = invisible and 1 or 0
           for _, child in ipairs(head:GetChildren()) do
               if child:IsA("Decal") then child.Transparency = invisible and 1 or 0 end
           end
       end
       for _, desc in ipairs(char:GetDescendants()) do
           if desc:IsA("Accessory") then
               local handle = desc:FindFirstChild("Handle")
               if handle then handle.Transparency = invisible and 1 or 0 end
           end
       end
   end)
end

local function getActiveNPCs()
   local options, count = {}, {}
   pcall(function()
      for _, obj in ipairs(workspace:GetDescendants()) do
         if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if hum and hrp and hum.Health > 0 and Players:GetPlayerFromCharacter(obj) == nil then
               count[obj.Name] = (count[obj.Name] or 0) + 1
               local label = obj.Name .. " [#" .. count[obj.Name] .. "]"
               npcMap[label] = obj
               table.insert(options, label)
            end
         end
      end
   end)
   if #options == 0 then table.insert(options, "Nenhum NPC encontrado") end
   return options
end

local function getValidTarget()
   local target = selectedLabel and npcMap[selectedLabel]
   if not target or not target.Parent then return nil end
   local hum = target:FindFirstChildOfClass("Humanoid")
   local hrp = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
   if hum and hrp and hum.Health > 0 then return target, hrp, hum end
   return nil
end

