MiscTab:CreateToggle({
   Name = "Fly Fluido",
   CurrentValue = false,
   Flag = "FlyToggle",
   Callback = function(Value)
      flyEnabled = Value
      local cam = workspace.CurrentCamera
      if flyEnabled then
         currentVelocity = Vector3.new(0, 0, 0)
         flyConn = RunService.RenderStepped:Connect(function(dt)
            local _, targetHRP = getValidTarget()
            local activePart = (controlConn and targetHRP) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            if activePart then
               local targetDir = Vector3.new(0,0,0)
               local cf = cam.CFrame
               if keys.W then targetDir = targetDir + cf.LookVector end
               if keys.S then targetDir = targetDir - cf.LookVector end
               if keys.A then targetDir = targetDir - cf.RightVector end
               if keys.D then targetDir = targetDir + cf.RightVector end
               if keys.Space then targetDir = targetDir + Vector3.new(0, 1, 0) end
               if keys.Shift then targetDir = targetDir - Vector3.new(0, 1, 0) end

               local desiredVelocity = targetDir.Magnitude > 0 and (targetDir.Unit * flySpeed) or Vector3.new(0, 0, 0)
               currentVelocity = currentVelocity:Lerp(desiredVelocity, math.clamp(dt * 12, 0, 1))
               activePart.AssemblyLinearVelocity = currentVelocity
            end
         end)
      else
         if flyConn then flyConn:Disconnect(); flyConn = nil end
         currentVelocity = Vector3.new(0, 0, 0)
      end
   end,
})

MiscTab:CreateToggle({
   Name = "Shiftlock (Estilo Roblox)",
   CurrentValue = false,
   Flag = "ShiftlockToggle",
   Callback = function(Value)
      local cam = workspace.CurrentCamera
      if Value then
         shiftlockConn = RunService.RenderStepped:Connect(function()
            local _, targetHRP = getValidTarget()
            local targetPart = (controlConn and targetHRP) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if targetPart and hum then
               hum.AutoRotate = false
               local camLook = cam.CFrame.LookVector
               local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
               if flatLook.Magnitude > 0 then
                  targetPart.CFrame = CFrame.new(targetPart.Position, targetPart.Position + flatLook)
               end
            end
         end)
      else
         if shiftlockConn then shiftlockConn:Disconnect(); shiftlockConn = nil end
         local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
         if hum then
            hum.AutoRotate = true
         end
      end
   end,
})

-- ==================== MONITOR & RESET ====================
task.spawn(function()
   while task.wait(1) do
      local char = LocalPlayer.Character
      local hum = char and char:FindFirstChildOfClass("Humanoid")
      if (hum and hum.Health <= 0) or (selectedLabel and selectedLabel ~= "") then
         local target, _, targetHum = getValidTarget()
         if (hum and hum.Health <= 0) or not target or not target.Parent or (targetHum and targetHum.Health <= 0) then
            if controlConn and controlToggleRef then controlToggleRef:Set(false) end
            if followConn and followToggleRef then followToggleRef:Set(false) end
            if spinConn and spinToggleRef then spinToggleRef:Set(false) end
            if viewConn and viewToggleRef then viewToggleRef:Set(false) end
            if wanderToggleRef then wanderToggleRef:Set(false) end
            selectedLabel = ""
         end
      end
   end
end)

