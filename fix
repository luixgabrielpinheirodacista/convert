controlToggleRef = NpcTab:CreateToggle({
   Name = "Controlar NPC (Mover + Pular)",
   CurrentValue = false,
   Flag = "WeldToggle",
   Callback = function(Value)
      local char = LocalPlayer.Character
      local myHum = char and char:FindFirstChildOfClass("Humanoid")
      local cam = workspace.CurrentCamera

      if Value then
         local target, targetHRP, targetHum = getValidTarget()
         local myHRP = char and char:FindFirstChild("HumanoidRootPart")
         if not targetHRP or not myHRP or not myHum then return end

         cam.CameraSubject = targetHum
         local oldWalkSpeed = myHum.WalkSpeed
         myHum.WalkSpeed = 0
         setHeadInvisible(char, true)

         if autoMoveConn then pcall(function() task.cancel(autoMoveConn) end); autoMoveConn = nil end

         pcall(function()
            targetHRP.Anchored = false
            for _, part in ipairs(target:GetDescendants()) do if part:IsA("BasePart") then part:SetNetworkOwner(LocalPlayer) end end
         end)

         controlConn = RunService.Heartbeat:Connect(function()
            if not target.Parent or targetHum.Health <= 0 or not myHRP.Parent then
               if controlConn then controlConn:Disconnect() end
               myHum.WalkSpeed = oldWalkSpeed
               cam.CameraSubject = myHum
               setHeadInvisible(char, false)
               return
            end

            targetHum.WalkSpeed = npcSpeed
            pcall(function()
               for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
               for _, part in ipairs(target:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
            end)

            targetHum:Move(myHum.MoveDirection, false)
            if myHum.Jump then targetHum.Jump = true end

            myHRP.CFrame = controlMode == "Dentro" and targetHRP.CFrame or (targetHRP.CFrame * CFrame.new(0, -6.5, 0))
            myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            myHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
         end)
      else
         if controlConn then controlConn:Disconnect(); controlConn = nil end

         pcall(function()
            local myHRP = char and char:FindFirstChild("HumanoidRootPart")
            local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local cam = workspace.CurrentCamera
            local target, _, targetHum = getValidTarget()
            local npcVivo = target and targetHum and targetHum.Health > 0

            if myHRP then
               myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
               myHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
               if npcVivo then myHRP.CFrame = myHRP.CFrame + Vector3.new(0, 5, 0) end
            end

            if myHum then myHum.WalkSpeed = 16; cam.CameraSubject = myHum end

            task.delay(0.15, function()
               if char then
                  setHeadInvisible(char, false)
                  for _, part in ipairs(char:GetDescendants()) do
                     if part:IsA("BasePart") then
                        if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" then
                           part.CanCollide = true
                        else
                           part.CanCollide = false
                        end
                     end
                     if part:IsA("SelectionBox") or part:IsA("SelectionSphere") or part:IsA("Highlight") then part:Destroy() end
                  end
               end
            end)
         end)
         Rayfield:Notify({Title = "Zen Eclipse", Content = "Controle liberado com segurança.", Duration = 2})
      end
   end,
})

