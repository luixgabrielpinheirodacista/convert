MainTab:CreateToggle({
	Name = "Modo Guarda (Direita + Olhar Player)",
	CurrentValue = false,
	Flag = "GuardMode",
	Callback = function(v)
		if guardConn then guardConn:Disconnect(); guardConn = nil end
		if v then
			local m, hrp, hum = getTarget()
			local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not m or not hrp or not hum or not myHRP then return end
			pcall(function() hrp.Anchored = false; applyOwner(m) end)
			guardConn = RunService.Heartbeat:Connect(function()
				local cm, chrp, chum = getTarget()
				local cmy = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not cm or not chrp or not chum or not cmy then
					if guardConn then guardConn:Disconnect(); guardConn = nil end
					return
				end
				chum.WalkSpeed = math.max(npcSpeed, 20)
				local rcf = cmy.CFrame * CFrame.new(4, 0, -1)
				local spot = Vector3.new(rcf.X, chrp.Position.Y, rcf.Z)
				local dSpot = (Vector3.new(chrp.Position.X, 0, chrp.Position.Z) - Vector3.new(spot.X, 0, spot.Z)).Magnitude
				local near = nearestPlayer(chrp.Position, guardRadius)
				if dSpot > 1.5 then
					chum.AutoRotate = true
					chum:MoveTo(spot)
				else
					chum:MoveTo(chrp.Position)
					if near then
						chum.AutoRotate = false
						local look = Vector3.new(near.Position.X, chrp.Position.Y, near.Position.Z)
						if (look - chrp.Position).Magnitude > 0.25 then
							chrp.CFrame = CFrame.lookAt(chrp.Position, look)
						end
					else
						chum.AutoRotate = true
					end
				end
			end)
		else
			local _, _, hum = getTarget()
			if hum then pcall(function() hum.AutoRotate = true end) end
		end
	end
})

MainTab:CreateToggle({
	Name = "Stand Mode (JoJo - Direita)",
	CurrentValue = false,
	Flag = "StandMode",
	Callback = function(v)
		if standConn then standConn:Disconnect(); standConn = nil end
		if v then
			local m, hrp, hum = getTarget()
			local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not m or not hrp or not hum or not myHRP then return end
			applyOwner(m)
			pcall(function()
				hum.PlatformStand = true
				hum.AutoRotate = false
				hrp.Anchored = true
			end)
			playStandAnim(hum)
			local t = 0
			standConn = RunService.Heartbeat:Connect(function(dt)
				t += dt
				local cm, chrp, chum = getTarget()
				local cmy = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not cm or not chrp or not chum or not cmy then
					if standConn then standConn:Disconnect(); standConn = nil end
					stopStand()
					return
				end
				chum.PlatformStand = true
				chrp.Anchored = true
				local bob = 1.35 + (math.sin(t * 3.5) * 0.28)
				local goal = cmy.CFrame * CFrame.new(3.2, bob, -1.15)
				local pos = chrp.Position:Lerp(goal.Position, math.clamp(dt * 12, 0, 1))
				local fl = Vector3.new(cmy.CFrame.LookVector.X, 0, cmy.CFrame.LookVector.Z)
				if fl.Magnitude > 0.01 then
					chrp.CFrame = CFrame.lookAt(pos, pos + fl.Unit)
				end
			end)
		else
			stopStand()
			local _, hrp, hum = getTarget()
			if hrp and hum then
				pcall(function()
					hum.PlatformStand = false
					hum.AutoRotate = true
					hrp.Anchored = false
				end)
			end
		end
	end
})

