		local cam = workspace.CurrentCamera

		if v then
			local m, hrp, hum = getTarget()
			if not m or not hrp or not hum or not myHum or not myHRP then
				setCharNoCollide(char, false)
				return
			end
			pcall(function()
				hrp.Anchored = false
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hum.UseJumpPower = true
				if hum.JumpPower < 60 then hum.JumpPower = 60 end
				applyOwner(m)
			end)
			myHum.WalkSpeed = 0
			setHeadHidden(char, true)
			setCharNoCollide(char, true)
			if cam then cam.CameraSubject = hum end

			local lastJump = 0
			controlConn = RunService.Heartbeat:Connect(function()
				if not m.Parent or hum.Health <= 0 or not myHRP.Parent then
					if controlConn then controlConn:Disconnect(); controlConn = nil end
					myHum.WalkSpeed = 16
					setHeadHidden(char, false)
					setCharNoCollide(char, false)
					if cam and myHum then cam.CameraSubject = myHum end
					return
				end
				setCharNoCollide(char, true)
				hum.WalkSpeed = npcSpeed
				hum.UseJumpPower = true
				if hum.JumpPower < 60 then hum.JumpPower = 60 end
				hum:Move(myHum.MoveDirection, false)

				if (myHum.Jump or keys.Space) and (os.clock() - lastJump) > 0.35 then
					lastJump = os.clock()
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
					hum.Jump = true
				end

				myHRP.CFrame = controlMode == "Dentro" and hrp.CFrame or (hrp.CFrame * CFrame.new(0, -15, 0))
				myHRP.AssemblyLinearVelocity = Vector3.zero
				myHRP.AssemblyAngularVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end)
		else
			if myHum then
				myHum.WalkSpeed = 16
				if cam then cam.CameraSubject = myHum end
			end
			setHeadHidden(char, false)
			setCharNoCollide(char, false)
		end
	end
})

