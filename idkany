local function getMainPart(model)
	if not model then return nil end
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart", true)
end

local function applyOwner(target)
	if not networkOwnershipEnabled or not target then return end
	pcall(function()
		for _, p in ipairs(target:GetDescendants()) do
			if p:IsA("BasePart") then
				p:SetNetworkOwner(LocalPlayer)
			end
		end
	end)
end

local function setCharNoCollide(char, noCollide)
	if not char then return end
	pcall(function()
		if noCollide then
			savedCharCollisions = {}
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") then
					savedCharCollisions[p] = p.CanCollide
					p.CanCollide = false
				end
			end
		else
			for part, oldVal in pairs(savedCharCollisions) do
				if part and part.Parent then
					part.CanCollide = oldVal
				end
			end
			savedCharCollisions = {}
		end
	end)
end

local function setHeadHidden(char, hide)
	if not char then return end
	pcall(function()
		local head = char:FindFirstChild("Head")
		if head then
			head.Transparency = hide and 1 or 0
			for _, d in ipairs(head:GetChildren()) do
				if d:IsA("Decal") then
					d.Transparency = hide and 1 or 0
				end
			end
		end
	end)
end

local function scanNPCs(filterText)
	local list, counts, map = {}, {}, {}
	local q = tostring(filterText or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")

	pcall(function()
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == nil then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				local hrp = getMainPart(obj)
				if hum and hrp and hum.Health > 0 then
					counts[obj.Name] = (counts[obj.Name] or 0) + 1
					local tag = obj.Name .. " [#" .. counts[obj.Name] .. "]"
					map[tag] = obj
					if q == "" or obj.Name:lower():find(q, 1, true) or tag:lower():find(q, 1, true) then
						table.insert(list, tag)
					end
				end
			end
		end
	end)

	if next(map) ~= nil then
		npcMap = map
	end

	table.sort(list)

	if #list == 0 then
		if q ~= "" then
			return { "Sem resultado: " .. filterText }
		elseif next(npcMap) ~= nil then
			local fallback = {}
			for tag in pairs(npcMap) do
				table.insert(fallback, tag)
			end
			table.sort(fallback)
			return fallback
		else
			return { "Nenhum NPC encontrado" }
		end
	end

	return list
end

local function refreshList()
	if not npcDropdown then return end
	local opts = scanNPCs(searchQuery)

	pcall(function()
		npcDropdown:Refresh(opts)
	end)

	local matchedLabel = nil
	if selectedModelRef and selectedModelRef.Parent then
		for lbl, m in pairs(npcMap) do
			if m == selectedModelRef then
				matchedLabel = lbl
				break
			end
		end
	elseif selectedLabel and npcMap[selectedLabel] then
		matchedLabel = selectedLabel
	end

	if matchedLabel then
		selectedLabel = matchedLabel
		pcall(function() npcDropdown:Set(matchedLabel) end)
	elseif opts[1] and not opts[1]:match("^Nenhum NPC") and not opts[1]:match("^Sem resultado") then
		selectedLabel = opts[1]
		selectedModelRef = npcMap[opts[1]]
		pcall(function() npcDropdown:Set(opts[1]) end)
	end
end

local function getTarget()
	local m = (selectedModelRef and selectedModelRef.Parent and selectedModelRef) or (selectedLabel and npcMap[selectedLabel])
	if not m or not m.Parent then return nil end
	local hum = m:FindFirstChildOfClass("Humanoid")
	local hrp = getMainPart(m)
	if hum and hrp and hum.Health > 0 then
		return m, hrp, hum
	end
	return nil
end

local function getNpcRigType(model, hum)
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		return "R15"
	elseif hum and hum.RigType == Enum.HumanoidRigType.R6 then
		return "R6"
	end
	if model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")) then
		return "R15"
	end
	return "R6"
end

local function formatAnimId(rawId)
	local cleaned = tostring(rawId or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if cleaned == "" then return nil end
	if cleaned:match("^rbxassetid://") or cleaned:match("^http") then
		return cleaned
	end
	local digits = cleaned:match("%d+")
	if digits then
		return "rbxassetid://" .. digits
	end
	return nil
end

local function stopNpcAnim()
	if npcAnimTrack then
		pcall(function()
			npcAnimTrack:Stop(0.15)
			npcAnimTrack:Destroy()
		end)
		npcAnimTrack = nil
	end
end

local function playNpcAnimation(animKeyOrId, looped)
	local m, _, hum = getTarget()
	if not m or not hum then
		Rayfield:Notify({ Title = "Zen Eclipse", Content = "Selecione um NPC válido primeiro.", Duration = 2 })
		return
	end

	applyOwner(m)
	stopNpcAnim()

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		pcall(function() animator = Instance.new("Animator", hum) end)
	end
	if not animator then return end

	local rig = getNpcRigType(m, hum)
	local candidates = {}

	local preset = rigAnimations[animKeyOrId]
	if preset then
		local primaryId = preset[rig]
		local fallbackRig = rig == "R15" and "R6" or "R15"
		local fallbackId = preset[fallbackRig]
		if primaryId then table.insert(candidates, primaryId) end
		if fallbackId and fallbackId ~= primaryId then table.insert(candidates, fallbackId) end
	else
		local formatted = formatAnimId(animKeyOrId)
		if formatted then
			table.insert(candidates, formatted)
		end
	end

	for _, animId in ipairs(candidates) do
		local anim = Instance.new("Animation")
		anim.AnimationId = animId
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		anim:Destroy()
		if ok and track then
			pcall(function()
				track.Priority = Enum.AnimationPriority.Action
				track.Looped = looped ~= false
				track:Play(0.15)
				track:AdjustSpeed(npcAnimSpeed)
			end)
			npcAnimTrack = track
			Rayfield:Notify({ Title = "Zen Eclipse", Content = "Animação (" .. rig .. ") ativada!", Duration = 2 })
			return
		end
	end

	Rayfield:Notify({ Title = "Zen Eclipse", Content = "Não foi possível carregar essa animação.", Duration = 2 })
end

local function nearestPlayer(fromPos, maxDist)
	local best, bestDist = nil, maxDist
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - fromPos).Magnitude
				if d <= bestDist then
					bestDist = d
					best = hrp
				end
			end
		end
	end
	return best
end

local function stopStand()
