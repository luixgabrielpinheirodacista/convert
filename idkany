local baseGravity = workspace.Gravity
local flyGravityConn = nil

local function syncFlyGravity(active)
	if flyGravityConn then flyGravityConn:Disconnect(); flyGravityConn = nil end
	if active then
		baseGravity = workspace.Gravity
		workspace.Gravity = 0
		flyGravityConn = RunService.Heartbeat:Connect(function()
			if flyEnabled then
				workspace.Gravity = 0
			end
		end)
	else
		workspace.Gravity = baseGravity
	end
end

MiscTab:CreateToggle({
	Name = "Fly Fluido",
	CurrentValue = false,
	Flag = "FluidFly",
	Callback = function(v)
		flyEnabled = v
		if flyConn then flyConn:Disconnect(); flyConn = nil end
		currentVelocity = Vector3.zero
		syncFlyGravity(v)

		if v then
			local cam = workspace.CurrentCamera
			flyConn = RunService.RenderStepped:Connect(function(dt)
				local _, hrp, humTarget = getTarget()
				local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local isControlling = (controlConn ~= nil) and (hrp ~= nil)
				local part = isControlling and hrp or myHRP

				if part and cam then
					if isControlling and humTarget then
						pcall(function()
							humTarget.PlatformStand = true
							humTarget.Sit = false
							hrp.Anchored = false
						end)
					end

					local dir = Vector3.zero
					local cf = cam.CFrame
					if keys.W then dir += cf.LookVector end
					if keys.S then dir -= cf.LookVector end
					if keys.A then dir -= cf.RightVector end
					if keys.D then dir += cf.RightVector end
					if keys.Space then dir += Vector3.new(0, 1, 0) end
					if keys.Shift then dir -= Vector3.new(0, 1, 0) end

					local goal = dir.Magnitude > 0 and (dir.Unit * flySpeed) or Vector3.zero
					currentVelocity = currentVelocity:Lerp(goal, math.clamp(dt * 16, 0, 1))
					part.AssemblyLinearVelocity = currentVelocity
					part.AssemblyAngularVelocity = Vector3.zero

					if isControlling and myHRP and myHRP.Parent then
						myHRP.CFrame = controlMode == "Dentro" and hrp.CFrame or (hrp.CFrame * CFrame.new(0, -15, 0))
						myHRP.AssemblyLinearVelocity = Vector3.zero
						myHRP.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end)
		else
			local _, hrp, humTarget = getTarget()
			local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if humTarget and humTarget.Parent then
				pcall(function() humTarget.PlatformStand = false end)
			end
			if hrp and hrp.Parent then
				pcall(function()
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end)
			end
			if myHRP and myHRP.Parent then
				pcall(function()
					myHRP.AssemblyLinearVelocity = Vector3.zero
					myHRP.AssemblyAngularVelocity = Vector3.zero
				end)
			end
		end
	end
})

