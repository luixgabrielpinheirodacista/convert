local function startAutoRefreshLoop()
	if autoRefreshRunning then return end
	autoRefreshRunning = true
	task.spawn(function()
		while autoRefreshEnabled do
			refreshList()
			task.wait(3)
		end
		autoRefreshRunning = false
	end)
end

local function startEspLoop()
	if espRunning then return end
	espRunning = true
	task.spawn(function()
		while espEnabled do
			local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if myHRP then
				local seen = {}
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == nil then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						local hrp = getMainPart(obj)
						if hum and hrp and hum.Health > 0 then
							local d = (hrp.Position - myHRP.Position).Magnitude
							if d <= npcNameRange then
								seen[obj] = true
								local bb = espTags[obj]
								if not bb or not bb.Parent then
									bb = Instance.new("BillboardGui")
									bb.Size = UDim2.new(0, 150, 0, 22)
									bb.StudsOffset = Vector3.new(0, 2.8, 0)
									bb.AlwaysOnTop = true
									bb.MaxDistance = npcNameRange
									bb.Parent = LocalPlayer:WaitForChild("PlayerGui")

									local lbl = Instance.new("TextLabel", bb)
									lbl.Size = UDim2.new(1, 0, 1, 0)
									lbl.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
									lbl.BackgroundTransparency = 0.25
									lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
									lbl.Font = Enum.Font.GothamBold
									lbl.TextSize = 11
									espTags[obj] = bb
								end
								bb.MaxDistance = npcNameRange
								bb.Adornee = obj:FindFirstChild("Head") or hrp
								local lbl = bb:FindFirstChildOfClass("TextLabel")
								if lbl then
									lbl.Text = string.format("%s [%.0f/%d]", obj.Name, d, npcNameRange)
								end
							end
						end
					end
				end

				for m in pairs(espTags) do
					if not seen[m] or not m.Parent then
						pcall(function() espTags[m]:Destroy() end)
						espTags[m] = nil
					end
				end
			else
				clearEsp()
			end
			task.wait(0.2)
		end
		clearEsp()
		espRunning = false
	end)
end

