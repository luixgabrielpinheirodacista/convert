-- Função para deixar o personagem 100% invisível e sem nome
local function setCharacterInvisible(char, invisible)
   pcall(function()
       for _, descendant in ipairs(char:GetDescendants()) do
           if descendant:IsA("BasePart") or descendant:IsA("MeshPart") then
               descendant.Transparency = invisible and 1 or 0
           elseif descendant:IsA("Accessory") then
               local handle = descendant:FindFirstChild("Handle")
               if handle then
                   handle.Transparency = invisible and 1 or 0
               end
           elseif descendant:IsA("BillboardGui") then
               descendant.Enabled = not invisible
           end
       end
       local head = char:FindFirstChild("Head")
       if head then
           for _, gui in ipairs(head:GetChildren()) do
               if gui:IsA("BillboardGui") then
                   gui.Enabled = not invisible
               end
           end
       end
   end)
end

-- Varre o workspace procurando NPCs vivos de forma universal
local function getActiveNPCs()
   local options = {}
   npcMap = {}
   local count = {}

   pcall(function()
      for _, obj in ipairs(workspace:GetDescendants()) do
         if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart

            if hum and hrp and hum.Health > 0 and Players:GetPlayerFromCharacter(obj) == nil then
               count[obj.Name] = (count[obj.Name] or 0) + 1
               local label = obj.Name .. " [#" .. count[obj.Name] .. "]"
               
               npcMap[label] = obj
               table.insert(options, label)
            end
         end
      end
   end)

   if #options == 0 then
      table.insert(options, "Nenhum NPC encontrado")
   end
   return options
end

local function getValidTarget()
   local target = selectedLabel and npcMap[selectedLabel]
   if not target or not target.Parent then return nil end
   local hum = target:FindFirstChildOfClass("Humanoid")
   local hrp = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
   if hum and hrp and hum.Health > 0 then
      return target, hrp, hum
   end
   return nil
end

