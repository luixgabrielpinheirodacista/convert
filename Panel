-- Controle Universal com Network Ownership e Limpeza
controlToggleRef = NpcTab:CreateToggle({
   Name = "Controlar NPC (Mover + Pular + Ownership)",
   CurrentValue = false,
   Flag = "WeldToggle",
   Callback = function(Value)
      local char = LocalPlayer.Character
      local myHum = char and char:FindFirstChildOfClass("Humanoid")
      local cam = workspace.CurrentCamera

      if Value then
         local target, targetHRP, targetHum = getValidTarget()
         local myHRP = char and char:FindFirstChild("HumanoidRootPart")

         if not targetHRP or not myHRP or not myHum then
            Rayfield:Notify({Title = "Erro", Content = "Selecione um NPC válido primeiro.", Duration = 2})
            return
         end

         cam.CameraSubject = targetHum
         local oldWalkSpeed = myHum.WalkSpeed
         myHum.WalkSpeed = 0

         setCharacterInvisible(char, true)

         if autoMoveConn then
            pcall(function() task.cancel(autoMoveConn) end)
            autoMoveConn = nil
         end

         pcall(function()
            targetHRP.Anchored = false
            for _, part in ipairs(target:GetDescendants()) do
               if part:IsA("BasePart") then
                  part:SetNetworkOwner(LocalPlayer)
               end
            end
         end)

         controlConn = RunService.Heartbeat:Connect(function()
            if not target.Parent or targetHum.Health <= 0 or not myHRP.Parent then
               if controlConn then controlConn:Disconnect() end
               myHum.WalkSpeed = oldWalkSpeed
               cam.CameraSubject = myHum
               setCharacterInvisible(char, false)
               return
            end

            targetHum.WalkSpeed = npcSpeed

            pcall(function()
               for _, part in ipairs(char:GetDescendants()) do
                  if part:IsA("BasePart") then part.CanCollide = false end
               end
               for _, part in ipairs(target:GetDescendants()) do
                  if part:IsA("BasePart") then part.CanCollide = false end
               end
            end)

            targetHum:Move(myHum.MoveDirection, false)
            if myHum.Jump then
               targetHum.Jump = true
            end

            if controlMode == "Dentro" then
               myHRP.CFrame = targetHRP.CFrame
            else
               myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, -4.5, 0)
            end

            myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            myHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
         end)
      else
         if controlConn then
            controlConn:Disconnect()
            controlConn = nil
         end

         if myHum then
            myHum.WalkSpeed = 16
            cam.CameraSubject = myHum
         end

         if char then
            setCharacterInvisible(char, false)
            pcall(function()
               for _, part in ipairs(char:GetDescendants()) do
                  if part:IsA("BasePart") then part.CanCollide = true end
               end
               for _, obj in ipairs(char:GetDescendants()) do
                  if obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") or obj:IsA("Highlight") then
                     obj:Destroy()
                  end
               end
            end)
         end

         pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
               if (obj:IsA("SelectionBox") or obj:IsA("SelectionSphere")) and obj.Adornee and char and obj.Adornee:IsDescendantOf(char) then
                  obj:Destroy()
               end
            end
         end)
      end
   end,
})

-- NPC Andar Sozinho
wanderToggleRef = NpcTab:CreateToggle({
   Name = "Andar Sozinho (Idle Wandering)",
   CurrentValue = false,
   Flag = "IdleWanderToggle",
   Callback = function(Value)
      if Value then
         local target, targetHRP, targetHum = getValidTarget()
         if not targetHRP then
            Rayfield:Notify({Title = "Erro", Content = "Selecione um NPC válido.", Duration = 2})
            return
         end

         autoMoveConn = task.spawn(function()
            while task.wait(3) do
               if not target.Parent or targetHum.Health <= 0 then break end
               local randomOffset = Vector3.new(math.random(-15, 15), 0, math.random(-15, 15))
               targetHum:MoveTo(targetHRP.Position + randomOffset)
            end
         end)
      else
         if autoMoveConn then
            pcall(function() task.cancel(autoMoveConn) end)
            autoMoveConn = nil
         end
      end
   end,
})


