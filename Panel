MiscTab:CreateToggle({
   Name = "Fly Fluido (Estilo Infinite Yield)",
   CurrentValue = false,
   Flag = "FlyToggle",
   Callback = function(Value)
      flyEnabled = Value
      local cam = workspace.CurrentCamera

      if flyEnabled then
         currentVelocity = Vector3.new(0, 0, 0)
         flyConn = RunService.RenderStepped:Connect(function(dt)
            local target, targetHRP = getValidTarget()
            local activePart = nil

            if controlConn and targetHRP then
               activePart = targetHRP
            else
               local char = LocalPlayer.Character
               activePart = char and char:FindFirstChild("HumanoidRootPart")
            end

            if activePart then
               local targetDir = Vector3.new(0,0,0)
               local cf = cam.CFrame

               if keys.W then targetDir = targetDir + cf.LookVector end
               if keys.S then targetDir = targetDir - cf.LookVector end
               if keys.A then targetDir = targetDir - cf.RightVector end
               if keys.D then targetDir = targetDir + cf.RightVector end
               if keys.Space then targetDir = targetDir + Vector3.new(0, 1, 0) end
               if keys.Shift then targetDir = targetDir - Vector3.new(0, 1, 0) end

               local desiredVelocity = Vector3.new(0, 0, 0)
               if targetDir.Magnitude > 0 then
                  desiredVelocity = targetDir.Unit * flySpeed
               end

               currentVelocity = currentVelocity:Lerp(desiredVelocity, math.clamp(dt * 12, 0, 1))
               activePart.AssemblyLinearVelocity = currentVelocity
            end
         end)
      else
         if flyConn then
            flyConn:Disconnect()
            flyConn = nil
         end
         currentVelocity = Vector3.new(0, 0, 0)
         pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
               hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
         end)
      end
   end,
})

