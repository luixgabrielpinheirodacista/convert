-- Follow Toggle (Seguir / Parar)
followToggleRef = NpcTab:CreateToggle({
   Name = "Follow NPC (Seguir / Parar)",
   CurrentValue = false,
   Flag = "FollowToggle",
   Callback = function(Value)
      if Value then
         local target, targetHRP, targetHum = getValidTarget()
         local char = LocalPlayer.Character
         local myHRP = char and char:FindFirstChild("HumanoidRootPart")

         if not targetHRP or not myHRP or not targetHum then
            Rayfield:Notify({Title = "Erro", Content = "Selecione um NPC válido primeiro.", Duration = 2})
            return
         end

         pcall(function()
            targetHRP.Anchored = false
            for _, part in ipairs(target:GetDescendants()) do
               if part:IsA("BasePart") then
                  part:SetNetworkOwner(LocalPlayer)
               end
            end
         end)

         followConn = RunService.Heartbeat:Connect(function()
            local currentTarget, currentHRP, currentHum = getValidTarget()
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            if not currentTarget or not currentHRP or not currentHum or not myRoot then
               if followConn then followConn:Disconnect() end
               return
            end

            currentHum.WalkSpeed = npcSpeed
            currentHum:MoveTo(myRoot.Position)
         end)
      else
         if followConn then
            followConn:Disconnect()
            followConn = nil
         end
         local _, _, targetHum = getValidTarget()
         if targetHum then
            targetHum:MoveTo(targetHum.RootPart.Position)
         end
      end
   end,
})

